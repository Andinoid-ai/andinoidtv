{
    "name": "[COLOR violet]Palantir 3[/COLOR] (buscar)",
    "plugin": "plugin.video.palantir3",
    "priority": 430,
    "is_resolvable": "false",
    "assert": {
        "search_movie": ["title"],
        "search_episode": ["showname"]
    },
    "search_movie": [
        "plugin://plugin.video.palantir3/",
        {"label": "(?i).*(buscar|search).*"},
        {"keyboard": "{title}"}
    ],
    "search_episode": [
        "plugin://plugin.video.palantir3/",
        {"label": "(?i).*(buscar|search).*"},
        {"keyboard": "{showname}"}
    ]
}
